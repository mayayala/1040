[32m+[m[32m  /// Configura notificaciones locales con canal para Android 8+[m
[32m+[m[32m  Future<void> _setupLocalNotifications() async {[m
[32m+[m[32m    const AndroidInitializationSettings initializationSettingsAndroid =[m
[32m+[m[32m        AndroidInitializationSettings('@mipmap/ic_launcher');[m
[32m+[m[41m    [m
[32m+[m[32m    const InitializationSettings initializationSettings = InitializationSettings([m
[32m+[m[32m      android: initializationSettingsAndroid,[m
[32m+[m[32m    );[m
[32m+[m[41m    [m
[32m+[m[32m    await _localNotifications.initialize(initializationSettings);[m
[32m+[m
[32m+[m[32m    // Crear canal de notificación para Android 8+[m
[32m+[m[32m    const AndroidNotificationChannel channel = AndroidNotificationChannel([m
[32m+[m[32m      'high_importance_channel',[m
[32m+[m[32m      'High Importance Notifications',[m
[32m+[m[32m      description: 'Notificaciones importantes de geocercas',[m
[32m+[m[32m      importance: Importance.high,[m
[32m+[m[32m      playSound: true,[m
[32m+[m[32m    );[m
[32m+[m
[32m+[m[32m    await _localNotifications[m
[32m+[m[32m        .resolvePlatformSpecificImplementation<AndroidFlutterLocalNotificationsPlugin>()[m
[32m+[m[32m        ?.createNotificationChannel(channel);[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  /// Guarda el token FCM en Firestore[m
[32m+[m[32m  Future<void> _saveFcmToken(String token) async {[m
[32m+[m[32m    final user = _auth.currentUser;[m
[32m+[m[32m    if (user != null) {[m
[32m+[m[32m      try {[m
[32m+[m[32m        await _firestore.collection('users').doc(user.uid).set({[m
[32m+[m[32m          'fcm_token': token,[m
[32m+[m[32m          'updated_at': FieldValue.serverTimestamp(),[m
[32m+[m[32m        }, SetOptions(merge: true));[m
[32m+[m[32m        debugPrint(' FCM Token guardado para ${user.uid}');[m
[32m+[m[32m      } catch (e) {[m
[32m+[m[32m        debugPrint(' Error al guardar token: $e');[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  /// Muestra notificación local cuando la app está en foreground[m
[32m+[m[32m  Future<void> _showLocalNotification(RemoteMessage message) async {[m
[32m+[m[32m    const AndroidNotificationDetails androidPlatformChannelSpecifics =[m
[32m+[m[32m        AndroidNotificationDetails([m
[32m+[m[32m      'high_importance_channel',[m
[32m+[m[32m      'High Importance Notifications',[m
[32m+[m[32m      channelDescription: 'Notificaciones importantes de geocercas',[m
[32m+[m[32m      importance: Importance.high,[m
[32m+[m[32m      priority: Priority.high,[m
[32m+[m[32m      playSound: true,[m
[32m+[m[32m    );[m
[32m+[m[41m    [m
[32m+[m[32m    const NotificationDetails platformChannelSpecifics =[m
[32m+[m[32m        NotificationDetails(android: androidPlatformChannelSpecifics);[m
[32m+[m
[32m+[m[32m    // Crear payload para deep linking[m
[32m+[m[32m    final payload = jsonEncode({[m
[32m+[m[32m      'type': message.data['type'],[m
[32m+[m[32m      'data': message.data,[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    await _localNotifications.show([m
[32m+[m[32m      message.hashCode,[m
[32m+[m[32m      message.notification?.title ?? 'Geocercas',[m
[32m+[m[32m      message.notification?.body ?? 'Nueva notificación',[m
[32m+[m[32m      platformChannelSpecifics,[m
[32m+[m[32m      payload: payload, // ← Esto permite capturar el toque[m
[32m+[m[32m    );[m
[32m+[m[32m  }[m
