[32m+[m[32m  final FlutterLocalNotificationsPlugin _localNotifications = FlutterLocalNotificationsPlugin();[m
[32m+[m
[32m+[m[32m  Future<String?> getCurrentToken() async {[m
[32m+[m[32m    // Si ya tenemos el token en cache, retornarlo[m
[32m+[m[32m    if (_currentToken != null) {[m
[32m+[m[32m      return _currentToken;[m
[32m+[m[32m    }[m
[32m+[m[41m    [m
[32m+[m[32m    // Si no, obtenerlo de Firebase[m
[32m+[m[32m    try {[m
[32m+[m[32m      _currentToken = await _messaging.getToken();[m
[32m+[m[32m      debugPrint(' Token FCM obtenido: ${_currentToken?.substring(0, 20)}...');[m
[32m+[m[32m      return _currentToken;[m
[32m+[m[32m    } catch (e) {[m
[32m+[m[32m      debugPrint(' Error al obtener token FCM: $e');[m
[32m+[m[32m      return null;[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  Future<void> refreshAndSaveToken() async {[m
[32m+[m[32m    try {[m
[32m+[m[32m      // Forzar refresh del token[m
[32m+[m[32m      _currentToken = await _messaging.getToken();[m
[32m+[m[41m      [m
[32m+[m[32m      if (_currentToken != null) {[m
[32m+[m[32m        await _saveFcmToken(_currentToken!);[m
[32m+[m[32m        debugPrint(' Token FCM refrescado y guardado');[m
[32m+[m[32m      }[m
[32m+[m[32m    } catch (e) {[m
[32m+[m[32m      debugPrint(' Error al refrescar token: $e');[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m
[32m+[m[32m  Future<void> init() async {[m
[32m+[m[32m    debugPrint(' Inicializando NotificationService...');[m
[32m+[m[41m    [m
[32m+[m[32m    // 1. Solicitar permisos[m
[32m+[m[32m    NotificationSettings settings = await _messaging.requestPermission([m
[32m+[m[32m      alert: true,[m
[32m+[m[32m      badge: true,[m
[32m+[m[32m      sound: true,[m
[32m+[m[32m    );[m
[32m+[m[32m    debugPrint(' Permisos de notificación: ${settings.authorizationStatus}');[m
[32m+[m
[32m+[m[32m    // 2. Inicializar notificaciones locales con canal para Android 8+[m
[32m+[m[32m    await _setupLocalNotifications();[m
[32m+[m
[32m+[m[32m    // 3. Obtener y guardar token[m
[32m+[m[32m    String? token = await _messaging.getToken();[m
[32m+[m[32m    debugPrint(' FCM Token obtenido: ${token?.substring(0, 20)}...');[m
[32m+[m[41m    [m
[32m+[m[32m    if (token != null) {[m
[32m+[m[32m      await _saveFcmToken(token);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 4. Escuchar cambios de token[m
[32m+[m[32m    _messaging.onTokenRefresh.listen(_saveFcmToken);[m
[32m+[m
[32m+[m[32m    // 5. Manejar mensajes en foreground[m
[32m+[m[32m    FirebaseMessaging.onMessage.listen((RemoteMessage message) {[m
[32m+[m[32m      debugPrint(' [FOREGROUND] Mensaje recibido: ${message.notification?.title}');[m
[32m+[m[32m      debugPrint('   Título: ${message.notification?.title}');[m
[32m+[m[32m      debugPrint('   Cuerpo: ${message.notification?.body}');[m
[32m+[m[32m      debugPrint('   Data: ${message.data}');[m
[32m+[m[32m      debugPrint('   Channel ID: ${message.notification?.android?.channelId}');[m
[32m+[m[41m      [m
[32m+[m[32m      _showLocalNotification(message);[m
[32m+[m[32m    });[m
[32m+[m[41m    [m
[32m+[m[32m    // 6.  Manejar cuando se toca una notificación (background/killed)[m
[32m+[m[32m    FirebaseMessaging.onMessageOpenedApp.listen((RemoteMessage message) {[m
[32m+[m[32m      debugPrint('️ Notificación tocada: type=${message.data['type']}');[m
[32m+[m[32m      NotificationNavigation().handleNotificationTap(message.data);[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    // 7. Manejar notificación al iniciar la app desde killed state[m
[32m+[m[32m    final initialMessage = await FirebaseMessaging.instance.getInitialMessage();[m
[32m+[m[32m    if (initialMessage != null) {[m
[32m+[m[32m      debugPrint(' App iniciada desde notificación: type=${initialMessage.data['type']}');[m
[32m+[m[32m      // Pequeño delay para asegurar que el router está listo[m
[32m+[m[32m      Future.delayed(const Duration(milliseconds: 500), () {[m
[32m+[m[32m        NotificationNavigation().handleNotificationTap(initialMessage.data);[m
[32m+[m[32m      });[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m  // Escuchar cambios de token (cuando Firebase lo refresca automáticamente)[m
[32m+[m[32m  _messaging.onTokenRefresh.listen((newToken) async {[m
[32m+[m[32m    debugPrint(' Token FCM refrescado por Firebase: ${newToken.substring(0, 20)}...');[m
[32m+[m[32m    _currentToken = newToken;[m
[32m+[m[41m    [m
[32m+[m[32m    // Si hay usuario autenticado, actualizar en Firestore[m
[32m+[m[32m    final user = FirebaseAuth.instance.currentUser;[m
[32m+[m[32m    if (user != null) {[m
[32m+[m[32m      await _firestore.collection('users').doc(user.uid).update({[m
[32m+[m[32m        'fcm_token': newToken,[m
[32m+[m[32m        'updated_at': FieldValue.serverTimestamp(),[m
[32m+[m[32m      });[m
[32m+[m[32m      debugPrint(' Token actualizado en Firestore para ${user.uid}');[m
[32m+[m[32m    }[m
[32m+[m[32m  });[m
[32m+[m[32m    debugPrint(' NotificationService inicializado');[m
[32m+[m[32m  }[m
